#!/usr/bin/env python3
"""fleet-status — single-pane health for the whole agent team (not one-by-one).

Combines THREE views, because no single one tells the truth:
  1. PLATFORM  (aX agents API, one call)  -> who the team is, control/kill-switch,
                                              sse_connected, routable, and SPACE
  2. LOCAL     (/proc + ss)               -> is the gateway process actually up,
                                              how many live :443 sockets
  3. RECEIPT   (logs/agent.log)           -> when did it LAST actually receive an
                                              inbound mention
  4. DRIFT     (/proc env + token/signal)  -> token TTL/401 and live listener
                                              space vs platform/agent-table space

"Good" = process up + token valid + platform routable + recent receipt.
Quiet != deaf: stale/no receipt is QUIET unless the listener is disconnected or
currently 401/token-wedged.

SPACE-AWARE: agents are GROUPED BY SPACE so cross-space agents are never confused
for broken. An agent in a different space than peach's home will not answer a
peach-originated probe (peach isn't a member there) — that is NOT deaf, just
elsewhere. Its liveness is judged from its own log receipt, and the row is shown
under its own space header.
"""
import json, os, subprocess, time, sys

QUIET_AFTER_S = 30 * 60         # no inbound in 30m while connected => quiet, not deaf
TOKEN_WEDGE_S = -600          # expired this long with process alive => token drift

# ── Config (env-overridable so another operator can point this at their box) ──
#   AX_FLEET_HOME      base dir holding agent homes        (default /home/ax-agents)
#   AX_FLEET_MCP       command to run aX MCP calls AS the fleet identity
#                      (default <HOME>/peach/bin/ax-peach)
#   AX_FLEET_IDENTITY  the probing agent's handle, anchors "my home space"
HERE     = os.environ.get("AX_FLEET_HOME", "/home/ax-agents")
IDENTITY = os.environ.get("AX_FLEET_IDENTITY", "peach")
MCP      = os.environ.get("AX_FLEET_MCP", f"{HERE}/{IDENTITY}/bin/ax-peach")

def sh(cmd):
    try: return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30).stdout
    except Exception: return ""

def platform_agents():
    # write to a temp file (large response truncates through a pipe at ~64KB)
    tmp = "/tmp/fleet_agents.json"
    sh(f"{MCP} agents action=list view_scope=all --output json 2>/dev/null > {tmp}")
    try: items = json.load(open(tmp))["data"]["items"]
    except Exception as e:
        print(f"(platform fetch failed: {e})", file=sys.stderr); return {}
    # last record wins on duplicate names
    return {a.get("name"): a for a in items if a.get("name")}

def local_gateways():
    """handle -> live proc/env facts for every running hermes gateway here."""
    res = {}
    for pid in sh("pgrep -f 'gateway run'").split():
        try:
            env = open(f"/proc/{pid}/environ", "rb").read().decode(errors="replace").split("\0")
        except Exception:
            continue
        e = dict(x.split("=", 1) for x in env if "=" in x)
        h = e.get("AX_AGENT_HANDLE")
        if not h:
            continue
        conns = sh(f"ss -tnp 2>/dev/null | grep -c 'pid={pid},'").strip()
        res[h] = {"pid": pid, "home": e.get("HERMES_HOME", ""), "conns": conns,
                  "token_file": e.get("AX_TOKEN_FILE", ""),
                  "env_space": e.get("AX_SPACE_ID", "")}
    return res

def agent_log(handle, home):
    """Resolve the agent's log: profile agents (-p <h>) log under profiles/<h>/logs."""
    if home:
        prof = os.path.join(home, "profiles", handle, "logs", "agent.log")
        if os.path.exists(prof):
            return prof
        base = os.path.join(home, "logs", "agent.log")
        if os.path.exists(base):
            return base
    return None

def last_inbound_age(log):
    if not log or not os.path.exists(log):
        return None
    # Receipt = either the per-agent dispatch line or the gateway inbound line.
    # Grep rotated (.1, older) FIRST then the current log, so `tail -1` is the
    # genuinely newest match (not the last line of the older rotated file).
    pat = "aX inbound dispatch|inbound message: platform=ax"
    last = sh(f"grep -hE '{pat}' {log}.1 {log} 2>/dev/null | tail -1")
    if not last:
        return None
    ts = last[:19]
    try:
        t = time.mktime(time.strptime(ts, "%Y-%m-%d %H:%M:%S"))
        return int(time.time() - t)
    except Exception:
        return None



def token_ttl(token_file):
    if not token_file:
        return None
    try:
        with open(os.path.expanduser(token_file)) as f:
            return int(json.load(f).get("expires_at", 0) - time.time())
    except Exception:
        return None

def token_state(ttl):
    if ttl is None: return "missing"
    if ttl < TOKEN_WEDGE_S: return "wedged"
    if ttl < 0: return "expired"
    return "valid"

def signal_state(handle):
    try:
        with open(os.path.expanduser(f"~/.ax/{handle}-signal.json")) as f:
            d = json.load(f)
        return {"sse_connected": d.get("connected"),
                "currently_401": d.get("currently_401"),
                "space_id": d.get("space_id"),
                "last_mention_at": d.get("last_mention_at")}
    except Exception:
        return {"sse_connected": None, "currently_401": None,
                "space_id": None, "last_mention_at": None}

def compact_drift(expected_space, live_space):
    if not live_space:
        return "?"
    if not expected_space:
        return "space?"
    return "space-ok" if str(expected_space) == str(live_space) else "SPACE-DRIFT"

def fmt_age(s):
    if s is None: return "never"
    if s < 90: return f"{s}s"
    if s < 5400: return f"{s//60}m"
    return f"{s//3600}h"

def short(uuid):
    return (uuid or "")[:8] or "—"

def main():
    plat = platform_agents()
    loc = local_gateways()
    # the team = anything cli OR running locally
    team = sorted(set(loc) | {n for n,a in plat.items() if a.get("connection_type")=="cli"})

    # the fleet identity's home space anchors "is this agent in my space?"
    peach_space = (plat.get(IDENTITY) or {}).get("space_id")

    # bucket the team by space_id
    by_space = {}
    for h in team:
        a = plat.get(h, {})
        sid = a.get("space_id") or "unknown"
        by_space.setdefault(sid, []).append(h)

    print(f"FLEET — {time.strftime('%Y-%m-%d %H:%M:%S')}   "
          f"(platform agents seen: {len(plat)}, local gateways: {len(loc)})")
    if peach_space:
        pname = (plat.get(IDENTITY) or {}).get('space_name') or short(peach_space)
        print(f"probing identity: @{IDENTITY}  home space: {pname} ({short(peach_space)})")
    print()

    # home space first, then the rest
    order = sorted(by_space, key=lambda s: (s != peach_space, s))
    for sid in order:
        handles = sorted(by_space[sid])
        # space name from any agent in it
        sname = next((plat[h].get("space_name") for h in handles if plat.get(h, {}).get("space_name")), None) or short(sid)
        tag = f"  ← {IDENTITY} home" if sid == peach_space else "  ← other space"
        print(f"SPACE  {sname}  ({short(sid)}){tag}")
        print(f"  {'HANDLE':11}{'VERDICT':16}{'PID':8}{'CONN':6}{'PLAT_SSE':9}{'CTRL':9}{'LAST_IN':9}{'TOKEN':9}{'SPACE':12}")
        for h in handles:
            a = plat.get(h, {})
            l = loc.get(h)
            ctrl = (a.get("control") or {}).get("state", "?")
            sig = signal_state(h)
            sse = sig["sse_connected"] if sig["sse_connected"] is not None else a.get("sse_connected")
            age = last_inbound_age(agent_log(h, l["home"])) if l else None
            ttl = token_ttl(l.get("token_file")) if l else None
            tok = "401" if sig["currently_401"] else token_state(ttl)
            live_space = sig["space_id"] or (l or {}).get("env_space")
            drift = compact_drift(a.get("space_id"), live_space)
            # Uniform liveness: own-log receipt is space-correct for EVERY agent.
            # Receipt staleness alone is quiet, not deaf; token and space drift
            # are separate verdicts.
            if ctrl == "disabled":
                v = "DISABLED"
            elif not l:
                v = "elsewhere" if a.get("connection_type") == "cli" else "down(local)"
            elif drift == "SPACE-DRIFT":
                v = "SPACE-DRIFT"
            elif tok in ("401", "wedged"):
                v = "TOKEN-DRIFT"
            elif age is not None and age <= QUIET_AFTER_S:
                v = "✓ OK"
            elif sse is False:
                v = "DEAF"
            else:
                v = "QUIET"
            print(f"  {h:11}{v:16}{(l['pid'] if l else '-'):8}{(l['conns'] if l else '-'):6}"
                  f"{str(sse):9}{str(ctrl):9}{fmt_age(age):9}{tok:9}{drift:12}")
        print()

    print("legend: ✓OK=received inbound <30m | QUIET=connected/no recent inbound (not a failure) | "
          "DEAF=local listener not connected | TOKEN-DRIFT=401/wedged token | "
          "SPACE-DRIFT=listener space differs from platform space | DISABLED=kill-switch")
    print("note: agents are grouped by platform space; drift/token/receipt dimensions stay separate.")

if __name__ == "__main__":
    main()
