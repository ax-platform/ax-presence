#!/usr/bin/env python3
"""fleet-probe — active round-trip health check for local agent gateways.

Sends each agent a direct @mention AS @peach, then verifies two things:
  RECEIVED : the mention shows up in the agent's own logs/agent.log within the
             window  ==> its SSE reader is ALIVE (the real deaf test)
  REPLIED  : a reply referencing the nonce comes back to peach's inbox
             (may be loop-suppressed for agent->agent; RECEIVED is the truth)

Usage: fleet-probe [handle ...]   (default: all local hermes gateways)
"""
import json, os, subprocess, sys, time

HERE = "/home/ax-agents"
WAIT = 45  # seconds to allow receipt + (possibly slow) reply

def sh(cmd, t=30):
    try: return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t).stdout
    except Exception: return ""

def local_gateways():
    res = {}
    for pid in sh("pgrep -f 'gateway run'").split():
        try: env = open(f"/proc/{pid}/environ").read().split("\0")
        except Exception: continue
        e = dict(x.split("=",1) for x in env if "=" in x)
        h = e.get("AX_AGENT_HANDLE")
        if h: res[h] = e.get("HERMES_HOME","")
    return res

def main():
    gws = local_gateways()
    targets = [h for h in (sys.argv[1:] or sorted(gws)) if h in gws]
    if not targets:
        print("no local gateways to probe", file=sys.stderr); sys.exit(1)
    nonce = "px" + str(int(time.time()))[-6:]
    print(f"probe nonce={nonce}  targets={targets}\n")
    t0 = time.time()
    for h in targets:
        msg = f'@{h} fleet health probe {nonce} — automated SSE check from @peach, please reply "ack {nonce}".'
        sh(f'{HERE}/peach/bin/ax-peach messages action=send content={json.dumps(msg)} bypass=true >/dev/null 2>&1')
        print(f"  sent -> @{h}")
    print(f"\nwaiting {WAIT}s for receipt/reply...\n")
    time.sleep(WAIT)

    # check replies into peach inbox once
    sh(f'{HERE}/peach/bin/ax-peach messages action=check limit=40 --output json >/tmp/peach_inbox.json 2>/dev/null')
    inbox = ""
    try: inbox = json.dumps(json.load(open("/tmp/peach_inbox.json")))
    except Exception: pass

    print(f"{'HANDLE':11}{'RECEIVED':10}{'REPLIED':9}VERDICT")
    for h in targets:
        log = os.path.join(gws[h], "logs", "agent.log")
        got = sh(f"grep -hF '{nonce}' {log} {log}.1 2>/dev/null | grep -c 'inbound message'").strip()
        received = got not in ("", "0")
        replied = (nonce in inbox and "ack" in inbox.lower())
        verdict = "✓ ALIVE" if received else "✗ DEAF (SSE not delivering)"
        print(f"{h:11}{('yes' if received else 'no'):10}{('yes' if replied else '-'):9}{verdict}")
    print(f"\n(elapsed {int(time.time()-t0)}s; RECEIVED=SSE reader alive is the authoritative signal)")

if __name__ == "__main__":
    main()
